<?xml version="1.0" encoding="utf-8"?>
<!--
  D-8-C1: 홈 통계 2카드 (시안 home.tsx (3) grid-cols-2 gap-3 기준).
  좌: 🔥 연속 학습(아이콘+라벨 14sp muted / 값 26sp bold accent) — ID tvStreakValue 보존.
  우: 📈 평균 점수(라벨 / 값 26sp bold accent + 델타 14sp success) — ID tvAvgValue·tvDeltaValue 보존.
  신규 아이콘 ImageView에 ivStreakIcon·ivAvgIcon ID 부여 (kt 접근 불요 — 표시만).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerStats"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStreak"
        style="@style/Widget.SeSAC.Card.D8C"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivStreakIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="연속 학습"
                    android:src="@drawable/ic_flame_24"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_stat_streak_label_d8c"
                    android:textAppearance="@style/TextAppearance.SeSAC.D8C.RowDate"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStreakValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/home_stat_placeholder"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.StatValue" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAvg"
        style="@style/Widget.SeSAC.Card.D8C"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivAvgIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="평균 점수"
                    android:src="@drawable/ic_trending_up_24"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_stat_avg_label_d8c"
                    android:textAppearance="@style/TextAppearance.SeSAC.D8C.RowDate"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAvgValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_stat_placeholder"
                    android:textAppearance="@style/TextAppearance.SeSAC.D8C.StatValue" />

                <TextView
                    android:id="@+id/tvDeltaValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="@style/TextAppearance.SeSAC.D8C.StatDelta"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>