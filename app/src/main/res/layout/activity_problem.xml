<?xml version="1.0" encoding="utf-8"?>
<!--
  D-8-C1/C2: 문제 풀이 화면 (시안 learn.$themeId StepView 재작성).
  D-8-C2 A-1: 카운트다운은 버블 원형 숫자만 갱신 (메시지는 고정 문구), 종료 시 INVISIBLE 자리 유지.
  D-8-C2 A-2: 녹음 UI = 시안 RecordPanel 카드 (원형 96dp accent + 마이크 40dp pulse + 상태 semibold
  + [녹음 완료] 전폭) + 보조 행([녹음 완료]·[힌트 보기]) — tvRecordingHint→tvRecordingStatus/
  tvTimer→tvRecordingTimer 개명 (kt 동기 수정).
  D-8-C3: 시안 1:1 상태머신 재작성 — render* 호출부 복원(R-0), play 카드(+btnTts 이동),
  완료 멘트 containerDuckDone, 제출 후 정오답 표시 없음(사용자 확정), LISTEN pill/음성형
  카드 문구 카운트다운 분기.
  ID: tvProgress/tvTypeBadge/progressBar/tvPassage/tvWait/tvSubmitCountdown
    containerAudioPlay/tvAudioPlayStatus/btnTts(재생카드 내부)
    cardImage/ivProblem/tvChoicesTitle/containerChoices/cardRecord/containerRecord/
    tvRecordingStatus/tvRecordingTimer/fabRecord/containerRecordActions/btnHint/
    btnSubmitRecording/tvHint/containerHint/containerDuckDone/tvDuckDoneMessage/
    containerSubmitted/btnNext/scoringOverlay.
  시간값(3초/5초/30초)은 기획 06 v1.7 유지.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grad_warm">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingBottom="24dp">

    <!-- 공통 헤더: X 닫기 44dp 카드형 (이탈 확인 팝업은 ProblemActivity finish 흐름 — 보류 표기) -->
    <FrameLayout
        android:id="@+id/btnClose"
        android:layout_width="@dimen/session_close_size"
        android:layout_height="@dimen/session_close_size"
        android:background="@drawable/bg_session_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@string/session_close_desc"
            android:src="@drawable/ic_close_24"
            app:tint="@color/text_secondary" />
    </FrameLayout>

    <!-- 진행바 flex-1 -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:indicatorColor="@color/brand_grad_brand_start"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintEnd_toStartOf="@id/tvProgress"
        app:layout_constraintStart_toEndOf="@id/btnClose"
        app:layout_constraintTop_toTopOf="@id/btnClose"
        app:trackColor="@color/brand_secondary"
        app:trackCornerRadius="@dimen/radius_pill"
        app:trackThickness="@dimen/progress_height" />

    <!-- n/total -->
    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.SeSAC.D8C.SettingRowDesc"
        android:textColor="@color/text_secondary"
        android:textStyle="bold"
        tools:text="1/8"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnClose" />

    <!-- ═════ D-8-C2 A-6: 가이드 단계 컨테이너 (GUIDE 단계에서만 표시) ═════
         ProblemGuideActivity의 UI를 이관 — 헤더(진행바)는 공용이라 미포함. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerGuidePhase"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvProgress">

        <!-- 유형 배지 (가이드 단계용 — 문항 단계는 하단 문항 블록이 자체 배지 사용) -->
        <TextView
            android:id="@+id/tvGuideTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textAppearance="@style/TextAppearance.SeSAC.D8C.Badge"
            android:textColor="@color/accent"
            tools:text="알아듣기"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/containerGuideDuck"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="bottom|start"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGuideTypeBadge">

            <ImageView
                android:id="@+id/imgDuckGuide"
                android:layout_width="@dimen/duck_banner"
                android:layout_height="@dimen/duck_banner"
                android:contentDescription="덕분이"
                android:src="@drawable/img_duck" />

            <TextView
                android:id="@+id/tvGuideBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_duck_banner_d8c"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.PageDesc"
                android:textColor="@color/text_primary"
                tools:text="이번 문제는 '알아듣기' 입니다." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/containerAudioCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_ai_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerGuideDuck">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="음성 안내"
                android:src="@drawable/ic_volume_24"
                app:tint="@color/accent" />

            <TextView
                android:id="@+id/tvGuideExtra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:lineSpacingExtra="4dp"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.PageDesc"
                android:textColor="@color/text_secondary"
                tools:text="이번 문제는 AI 음성을 들어야 해요." />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardGuideImage"
            android:layout_width="0dp"
            android:layout_height="176dp"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/radius_3xl"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerAudioCard">

            <ImageView
                android:id="@+id/imgGuideProblem"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="문제 이미지"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReady"
            style="@style/Widget.SeSAC.Button.D8C.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="24dp"
            android:text="@string/guide_btn_ready"
            app:cornerRadius="@dimen/radius_xl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardGuideImage" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <!-- ═════ A-6 가이드 단계 컨테이너 끝 ═════ -->

    <!-- 유형 배지 + 지문 (문항 단계) -->
    <TextView
        android:id="@+id/tvTypeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textAppearance="@style/TextAppearance.SeSAC.D8C.Badge"
        android:textColor="@color/accent"
        tools:text="이름대기"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnClose" />

    <TextView
        android:id="@+id/tvPassage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.SeSAC.D8C.StepTitle"
        android:textColor="@color/text_primary"
        tools:text="사진 안의 물건은 무엇인가요?"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTypeBadge" />

    <!-- ─── WaitCountdown 카드: 원형 80dp secondary + 숫자 32sp + 메시지 (코드에서 갱신) ─── -->
    <LinearLayout
        android:id="@+id/tvWait"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="32dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPassage">

        <FrameLayout
            android:layout_width="@dimen/wait_circle_size"
            android:layout_height="@dimen/wait_circle_size"
            android:background="@drawable/bg_wait_circle">

            <TextView
                android:id="@+id/tvWaitNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.WaitNumber"
                tools:text="3" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvWaitMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.SeSAC.D8C.SettingRow"
            tools:text="3초 후 질문 음성이 나와요. 집중하세요!" />
    </LinearLayout>

    <!-- ─── 재생 카드 (LISTEN·SHADOWING play 단계 — 시안: 원형 gradient + 스피커 + 상태 문구
         + [다시 듣기] outline은 LISTEN answer 단계에만 코드에서 표시) ─── -->
    <LinearLayout
        android:id="@+id/containerAudioPlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="24dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWait">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_grad_brand_r22">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="음성 재생"
                android:src="@drawable/ic_volume_24"
                app:tint="@color/brand_on_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvAudioPlayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.SeSAC.D8C.SettingRow"
            tools:text="질문을 들려드리고 있어요" />

        <!-- D-8-C3 S-1: [다시 듣기]는 시안상 재생 카드 내부 (containerSubmitted 아래에서 이동) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTts"
            style="@style/Widget.SeSAC.Button.D8C.Outline"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:drawableStart="@drawable/ic_volume_24"
            android:drawablePadding="6dp"
            android:drawableTint="@color/text_primary"
            android:text="@string/btn_replay"
            android:textSize="15sp"
            android:visibility="gone"
            app:cornerRadius="@dimen/radius_xl" />
    </LinearLayout>

    <!-- ─── SubmitCountdown 30초 (보더 2dp pill — 위험 상태 배경 전환은 코드) ─── -->
    <TextView
        android:id="@+id/tvSubmitCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_countdown_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textAppearance="@style/TextAppearance.SeSAC.D8C.SettingRow"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="남은 시간 30초"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerAudioPlay" />

    <!-- ─── 이미지 영역 (NAMING/SELF_TALK 208dp radius 30dp) ─── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardImage"
        android:layout_width="0dp"
        android:layout_height="208dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/radius_3xl"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubmitCountdown">

        <ImageView
            android:id="@+id/ivProblem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="문제 이미지"
            android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

    <!-- ─── LISTEN: 선택지 리스트 ─── -->
    <TextView
        android:id="@+id/tvChoicesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="정답을 골라주세요"
        android:textAppearance="@style/TextAppearance.SeSAC.D8C.SectionTitle"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardImage" />

    <LinearLayout
        android:id="@+id/containerChoices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvChoicesTitle" />

    <!-- ─── 녹음/제출 (NAMING/SHADOWING/SELF_TALK + LISTEN 제출 버튼 공용) ─── -->
    <!-- D-8-C2 A-2: 시안 RecordPanel 카드 재현 — 카드 중앙 정렬·gap 16dp·상하 padding 32dp:
         원형 96dp accent + 마이크 40dp(pulse 코드) + "녹음 중이에요 · 남은 시간 N초" 16sp semibold
         + [녹음 완료] 전폭 primary. 힌트/타이머는 기획 요소로 카드 외부(아래) 배치. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRecord"
        style="@style/Widget.SeSAC.Card.D8C"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardImage">

        <LinearLayout
            android:id="@+id/containerRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp">

            <FrameLayout
                android:id="@+id/frameMicPulse"
                android:layout_width="@dimen/record_mic_size"
                android:layout_height="@dimen/record_mic_size"
                android:background="@drawable/bg_mic_circle_accent">

                <ImageView
                    android:id="@+id/ivRecordMic"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="녹음"
                    android:src="@drawable/ic_mic_filled_24"
                    app:tint="@color/brand_on_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvRecordingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/recording_now"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.SettingRow"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRecordingTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/recording_timer_default"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.RowDate"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fabRecord"
                style="@style/Widget.SeSAC.Button.D8C.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="16dp"
                android:text="@string/btn_recording_start"
                app:cornerRadius="@dimen/radius_xl" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 기존 보조 버튼 행 ([녹음 완료]·[힌트 보기]) — 시안 유지 요소 + 기획 힌트 (카드 아래) -->
    <LinearLayout
        android:id="@+id/containerRecordActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardRecord">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHint"
            style="@style/Widget.SeSAC.Button.D8C.Outline"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_lightbulb_24"
            android:drawablePadding="6dp"
            android:drawableTint="@color/brand_on_primary"
            android:text="@string/hint_request"
            android:textSize="15sp"
            android:visibility="gone"
            app:cornerRadius="@dimen/radius_xl" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitRecording"
            style="@style/Widget.SeSAC.Button.D8C.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/btn_recording_stop"
            app:cornerRadius="@dimen/radius_xl" />
    </LinearLayout>

    <!-- ─── 힌트 표시 (NAMING) — DuckSays 패턴 ─── -->
    <LinearLayout
        android:id="@+id/containerHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="bottom|start"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerRecordActions">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="덕분이"
            android:src="@drawable/img_duck" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_duck_banner_d8c"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textAppearance="@style/TextAppearance.SeSAC.D8C.PageDesc"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- ─── 제출 완료 상태 ───
         D-8-C3: 음성형 완료 멘트(DuckSays 패턴 containerDuckDone — 유형별 문구) +
         시안 SubmitResult(체크 원형 40dp + "답안이 제출되었어요" + [다음으로]).
         LISTEN은 멘트 없음 (사용자 확정 — 정오답 실시간 표시 폐기). -->
    <LinearLayout
        android:id="@+id/containerDuckDone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="bottom|start"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerHint">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="덕분이"
            android:src="@drawable/img_duck" />

        <TextView
            android:id="@+id/tvDuckDoneMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_duck_banner_d8c"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textAppearance="@style/TextAppearance.SeSAC.D8C.PageDesc"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerSubmitted"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerDuckDone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="@dimen/result_check_size"
                android:layout_height="@dimen/result_check_size"
                android:background="@drawable/bg_check_circle_success">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="제출 완료"
                    android:src="@drawable/ic_check_24"
                    app:tint="@color/success" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSubmittedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/submitted_answer"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.SettingRow" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            style="@style/Widget.SeSAC.Button.D8C.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="16dp"
            android:text="@string/btn_next"
            app:cornerRadius="@dimen/radius_xl" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

    <!-- ─── 채점/제출 대기 오버레이 — "답안을 제출 중이에요" ─── -->
    <FrameLayout
        android:id="@+id/scoringOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_recording_overlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/primary"
                app:indicatorSize="44dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/submitting_answer"
                android:textAppearance="@style/TextAppearance.SeSAC.H4"
                android:textColor="@color/surface" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>