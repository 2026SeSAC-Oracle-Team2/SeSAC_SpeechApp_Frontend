<?xml version="1.0" encoding="utf-8"?>
<!-- P3-26 문제 풀이 화면 — 유형별 레이아웃 전환(visibility) + 상단 프로그레스 + D-7 시간 통제 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">



<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="24dp">

    <!-- 상단: 프로그레스 "n / 8" -->
    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:textAppearance="@style/TextAppearance.SeSAC.H3"
        android:textColor="@color/text_primary"
        tools:text="1 / 8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTypeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textAppearance="@style/TextAppearance.SeSAC.H4"
        android:textColor="@color/primary"
        tools:text="따라말하기"
        app:layout_constraintBaseline_toBaselineOf="@id/tvProgress"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        app:indicatorColor="@color/primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvProgress"
        app:trackColor="@color/border"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

    <!-- 공통: 문제 지문 -->
    <TextView
        android:id="@+id/tvPassage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:textAppearance="@style/TextAppearance.SeSAC.H4"
        android:textColor="@color/text_primary"
        tools:text="여기서 금요일이 며칠인지 말해보세요"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar" />

    <!-- D-7: 대기 카운트다운 (3초/5초 — 시니어 UI 큰 문구) -->
    <TextView
        android:id="@+id/tvWait"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_feedback_card"
        android:gravity="center"
        android:padding="16dp"
        android:lineSpacingExtra="6dp"
        android:textAppearance="@style/TextAppearance.SeSAC.H3"
        android:textColor="@color/primary"
        android:visibility="gone"
        tools:text="3초 후 질문 음성이 나와요.\n집중하세요! 3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPassage" />

    <!-- D-7: 제출 카운트다운 30초 (시각적 표시) -->
    <!-- D-8③ 시안 SubmitCountdown: 보더 카드형 — 남은시간 강조 -->
    <TextView
        android:id="@+id/tvSubmitCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_countdown_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textAppearance="@style/TextAppearance.SeSAC.H4"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="남은 시간 30초"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWait" />

    <!-- TTS 재생 (LISTEN 공통 — 있을 때만 표시. SHADOWING은 코드에서 GONE) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTts"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="▶ 다시듣기"
        app:cornerRadius="12dp"
        app:layout_constraintStart_toStartOf="@id/tvPassage"
        app:layout_constraintTop_toBottomOf="@id/tvSubmitCountdown" />

    <!-- 이미지 영역 (NAMING/SELF_TALK) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardImage"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardCornerRadius="30dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnTts">

        <ImageView
            android:id="@+id/ivProblem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="문제 이미지"
            android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

    <!-- ─── LISTEN: 선택지 리스트 ─── -->
    <TextView
        android:id="@+id/tvChoicesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="정답을 골라주세요"
        android:textAppearance="@style/TextAppearance.SeSAC.H4"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/tvPassage"
        app:layout_constraintTop_toBottomOf="@id/cardImage" />

    <LinearLayout
        android:id="@+id/containerChoices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvChoicesTitle" />

    <!-- ─── 힌트 표시 (NAMING) ─── -->
    <TextView
        android:id="@+id/tvHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_feedback_card"
        android:padding="12dp"
        android:textAppearance="@style/TextAppearance.SeSAC.Body"
        android:textColor="@color/text_primary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerRecord" />

    <!-- ─── 녹음/제출 (NAMING/SHADOWING/SELF_TALK + LISTEN 제출 버튼 공용) ─── -->
    <LinearLayout
        android:id="@+id/containerRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardImage">

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recording_timer_default"
            android:textAppearance="@style/TextAppearance.SeSAC.H3"
            android:textColor="@color/text_primary" />

        <!-- D-7 시니어 UI: 마이크 아이콘 대신 굵은 텍스트 버튼 (녹음 시작/녹음 완료) -->
        <!-- D-8③ 시안 RecordPanel: [녹음 시작/완료] — gradient-brand 버튼 (녹음 중 코드 tint로 error 전환) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabRecord"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_recording_start"
            android:textAppearance="@style/TextAppearance.SeSAC.H3"
            android:textColor="@color/brand_on_primary"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHint"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:text="@string/hint_request"
                android:visibility="gone"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitRecording"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="@color/primary"
                android:text="@string/btn_recording_stop"
                android:textColor="@color/surface"
                android:enabled="false"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecordingHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/recording_now"
            android:textAppearance="@style/TextAppearance.SeSAC.Body"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <!-- D-7: 제출 완료 상태 — "답안이 제출되었어요" + [다음으로] (제출/이동 분리) -->
    <LinearLayout
        android:id="@+id/containerSubmitted"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerRecord">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/submitted_answer"
            android:textAppearance="@style/TextAppearance.SeSAC.H3"
            android:textColor="@color/success" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_grad_brand"
            android:backgroundTint="@null"
            android:text="@string/btn_next"
            android:textAppearance="@style/TextAppearance.SeSAC.H4"
            android:textColor="@color/brand_on_primary"
            android:textStyle="bold"
            app:cornerRadius="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

    <!-- ─── 채점/제출 대기 오버레이 — "답안을 제출 중이에요" ─── -->
    <FrameLayout
        android:id="@+id/scoringOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_recording_overlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/primary"
                app:indicatorSize="44dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/submitting_answer"
                android:textAppearance="@style/TextAppearance.SeSAC.H4"
                android:textColor="@color/surface" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>