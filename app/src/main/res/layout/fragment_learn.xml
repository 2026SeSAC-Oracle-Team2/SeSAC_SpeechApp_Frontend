<?xml version="1.0" encoding="utf-8"?>
<!--
  D-8-C1/C2: 홈 탭 (시안 home.tsx 기준).
  D-8-C2 C-3: FAB를 NestedScrollView 외부(화면 고정 우하단)로 이동 — 리스트와 스크롤
  따라다니지 않음 + 컨테이너 clipChildren=false로 음영 잘림 방지 + 하단 margin 축소.
  구성 순서: (1) 날짜+인사 헤더 → (2) DuckSays → (3) 2열 통계 카드 → (4) 오늘의 학습 카드
  → (5) 최근 학습 결과 → (6) 최근 3건 리스트 → (7) FAB(고정).
  ID 보존: tvTitle/cardHero/btnStart/containerStats(tvStreakValue·tvAvgValue·tvDeltaValue)/
           containerRecent/tvRecentEmpty/tvMoreHint (Binding 파손 방지 — 지시문 §5).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grad_warm">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/d8c_screen_h"
            android:paddingBottom="160dp">

            <!-- (1) 헤더: 오늘 날짜 + 인사 -->
        <TextView
            android:id="@+id/tvHomeDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d8c_screen_top"
            android:textAppearance="@style/TextAppearance.SeSAC.D8C.PageDesc"
            tools:text="9월 6일 토요일"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home_greeting"
            android:textAppearance="@style/TextAppearance.SeSAC.D8C.PageTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHomeDate" />

        <!-- (2) DuckSays 버블: 오리 72dp + 말풍선 카드 -->
        <LinearLayout
            android:id="@+id/containerDuckSaysHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="bottom|start"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <ImageView
                android:layout_width="@dimen/duck_banner"
                android:layout_height="@dimen/duck_banner"
                android:contentDescription="덕분이"
                android:src="@drawable/img_duck" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_duck_banner_d8c"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="@string/duck_says_home_banner"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.PageDesc"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- (3) 2열 통계 카드 grid-cols-2 gap-3 — include 경유 참조 규약(binding.containerStats.tvX) -->
        <include
            android:id="@+id/containerStats"
            layout="@layout/view_home_stats_cards"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerDuckSaysHome" />

        <!-- (4) 오늘의 학습 카드 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHero"
            style="@style/Widget.SeSAC.Card.D8C"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerStats">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/card_today_title"
                        android:textAppearance="@style/TextAppearance.SeSAC.D8C.SectionTitle"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="@string/card_today_badge_d8c"
                        android:textAppearance="@style/TextAppearance.SeSAC.D8C.Badge"
                        android:textColor="@color/accent" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_grad_brand_r22"
                    android:backgroundTint="@null"
                    android:drawableEnd="@drawable/ic_play_24"
                    android:drawableTint="@color/brand_on_primary"
                    android:gravity="center"
                    android:text="@string/card_today_btn"
                    android:textAppearance="@style/TextAppearance.SeSAC.H4"
                    android:textColor="@color/brand_on_primary"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_xl" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- (5) 최근 학습 결과 섹션 제목 -->
        <TextView
            android:id="@+id/tvRecentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:text="@string/home_recent_title_d8c"
            android:textAppearance="@style/TextAppearance.SeSAC.D8C.SectionTitle"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardHero" />

        <!-- (6) 최근 3건 — 빈 상태 + 리스트 (kt가 item_home_recent inflate) -->
        <TextView
            android:id="@+id/tvRecentEmpty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_recent_empty_d8c"
            android:textAppearance="@style/TextAppearance.SeSAC.D8C.PageDesc"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRecentTitle" />

        <LinearLayout
            android:id="@+id/containerRecent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRecentEmpty" />

        <TextView
            android:id="@+id/tvMoreHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_recent_more_d8c"
            android:textAppearance="@style/TextAppearance.SeSAC.D8C.PageDesc"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerRecent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- (7) FAB: 말풍선 + 오리 원형 버튼 — C-3: 스크롤 외부 고정 (리스트와 겹침 완화·음영 온전) -->
    <LinearLayout
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fab_bubble"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="@string/fab_speech_bubble"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.FabBubble" />

            <!-- 꼬리(회전 사각) -->
            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="-6dp"
                android:background="@drawable/bg_fab_bubble_tail"
                android:rotation="45" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="@dimen/fab_duck_size"
            android:layout_height="@dimen/fab_duck_size"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_fab_circle"
            android:elevation="6dp">

            <ImageView
                android:layout_width="@dimen/fab_duck_inner"
                android:layout_height="@dimen/fab_duck_inner"
                android:layout_gravity="center"
                android:contentDescription="@string/fab_chat_desc"
                android:src="@drawable/img_duck" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>