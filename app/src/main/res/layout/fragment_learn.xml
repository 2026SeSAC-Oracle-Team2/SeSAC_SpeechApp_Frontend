<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Title: 홈 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="@string/tab_home"
            android:textAppearance="@style/TextAppearance.SeSAC.H1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- D-8③ 시안 home: DuckSays 배너 (마스코트 + 말풍선) -->
        <LinearLayout
            android:id="@+id/containerDuckSaysHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:gravity="bottom|start"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="덕분이"
                android:src="@drawable/img_duck" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_duck_banner"
                android:padding="16dp"
                android:text="@string/duck_says_theme_banner"
                android:textAppearance="@style/TextAppearance.SeSAC.Body"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- D-8②b 홈 통계 2카드 (연속 학습 / 평균 점수) — 시안 home.tsx 기준 -->
        <include
            android:id="@+id/containerStats"
            layout="@layout/view_home_stats_cards"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerDuckSaysHome" />

        <!-- Hero Card: 오늘의 학습 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHero"
            style="@style/Widget.SeSAC.Card.Hero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerStats">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 제목 + 문항 배지 (시안: 오늘의 학습 · 12문항 뱃지 → SSOT 문구) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/card_today_title"
                        android:textAppearance="@style/TextAppearance.SeSAC.H3"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="@string/card_today_sub_d8b"
                        android:textAppearance="@style/TextAppearance.SeSAC.Label"
                        android:textColor="@color/accent" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/card_today_sub"
                    android:textAppearance="@style/TextAppearance.SeSAC.Body"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_grad_brand"
                    android:backgroundTint="@null"
                    android:text="@string/card_today_start"
                    android:textAppearance="@style/TextAppearance.SeSAC.H4"
                    android:textColor="@color/brand_on_primary"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- D-8③ 시안 home: 최근 학습 결과 — 최근 3개 (더보기는 기록 탭) -->
        <TextView
            android:id="@+id/tvRecentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:text="@string/home_recent_title"
            android:textAppearance="@style/TextAppearance.SeSAC.H3"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardHero" />

        <TextView
            android:id="@+id/tvRecentEmpty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:text="@string/home_recent_empty"
            android:textAppearance="@style/TextAppearance.SeSAC.Body"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRecentTitle" />

        <LinearLayout
            android:id="@+id/containerRecent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRecentTitle" />

        <!-- 기록 탭 안내 (최근 목록 전체는 기록 탭) -->
        <TextView
            android:id="@+id/tvMoreHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/home_recent_more"
            android:textAppearance="@style/TextAppearance.SeSAC.Caption"
            android:textColor="@color/text_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerRecent" />

</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>