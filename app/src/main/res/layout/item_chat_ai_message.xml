<?xml version="1.0" encoding="utf-8"?>
<!--
  D-8-C1: 채팅 AI 메시지 행 (시안 ChatStep DuckSays size 48 재작성).
  오리 48dp + 풍선 카드(radius 22dp, 좌하만 4dp). ID 보존: ivAvatar/cardBubble/tvContent/tvTimestamp.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">

    <!-- DuckSays 오리 48dp -->
    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="@dimen/duck_chat"
        android:layout_height="@dimen/duck_chat"
        android:contentDescription="@string/ai_name"
        android:src="@drawable/img_duck"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 풍선 카드 (bg_ai_bubble: 좌하단만 작은 모서리) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@android:color/transparent"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toEndOf="@id/ivAvatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/chat_ai_bubble_max">

        <TextView
            android:id="@+id/tvContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ai_bubble"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textAppearance="@style/TextAppearance.SeSAC.D8C.PageDesc"
            android:textColor="@color/text_primary" />
    </androidx.cardview.widget.CardView>

    <!-- 타임스탬프 (기존 체계 유지 — 시안에 없어 축소 표기) -->
    <TextView
        android:id="@+id/tvTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.SeSAC.Caption"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        app:layout_constraintStart_toEndOf="@id/ivAvatar"
        app:layout_constraintTop_toBottomOf="@id/cardBubble" />

</androidx.constraintlayout.widget.ConstraintLayout>