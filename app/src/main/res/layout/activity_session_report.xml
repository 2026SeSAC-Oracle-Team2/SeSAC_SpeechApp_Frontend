<?xml version="1.0" encoding="utf-8"?>
<!-- P3-26 결과 화면: AQ + 방사형 그래프 + 피드백 6종 -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_title"
            android:textAppearance="@style/TextAppearance.SeSAC.H1" />

        <!-- 로딩 상태 -->
        <LinearLayout
            android:id="@+id/containerLoading"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/primary"
                app:indicatorSize="44dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/report_loading"
                android:textAppearance="@style/TextAppearance.SeSAC.H4"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- 결과 본문 -->
        <LinearLayout
            android:id="@+id/containerResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- AQ 큰 숫자 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_aq_label"
                android:textAppearance="@style/TextAppearance.SeSAC.H4"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvAQ"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/primary"
                android:textSize="72sp"
                android:textStyle="bold" />

            <!-- 방사형 그래프 -->
            <com.sesac.speechapp.ui.learning.RadarChartView
                android:id="@+id/radarChart"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="8dp" />

            <!-- 피드백 6종 카드 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="피드백"
                android:textAppearance="@style/TextAppearance.SeSAC.H3" />

            <TextView
                android:id="@+id/tvFeedbackListen"
                style="@style/FeedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvFeedbackNaming"
                style="@style/FeedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvFeedbackShadowing"
                style="@style/FeedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvFeedbackSelfTalk"
                style="@style/FeedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvFeedbackTalk"
                style="@style/FeedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvFeedbackTotal"
                style="@style/FeedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_hero" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/error"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_retry"
            android:textColor="@color/surface"
            android:visibility="gone"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_done"
            android:textAppearance="@style/TextAppearance.SeSAC.H4"
            android:textColor="@color/surface"
            android:visibility="gone"
            app:cornerRadius="14dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>