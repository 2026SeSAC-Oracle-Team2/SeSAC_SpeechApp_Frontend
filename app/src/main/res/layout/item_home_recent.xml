<?xml version="1.0" encoding="utf-8"?>
<!--
  D-8③ 시안 home/records 이력 카드 아이템 — 홈 최근3개 + 기록탭 공용.
  터치 영역 카드(card-soft) / 좌측 제목+날짜 / 우측 AQ 점수 + chevron.
  기존 item_session_history와 별도 신규 파일 (기록탭 기존 어댑터 영향 없음).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_soft"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecentTopic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SeSAC.H4"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvRecentDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.SeSAC.Caption"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRecentAq"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="@style/TextAppearance.SeSAC.H3"
        android:textColor="@color/accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="›"
        android:textAppearance="@style/TextAppearance.SeSAC.H3"
        android:textColor="@color/text_secondary" />
</LinearLayout>