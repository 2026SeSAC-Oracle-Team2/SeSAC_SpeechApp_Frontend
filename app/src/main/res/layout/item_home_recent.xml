<?xml version="1.0" encoding="utf-8"?>
<!--
  D-8-C1: 홈 최근 학습 결과 행 (시안 home.tsx (6) card-soft 가로행 기준).
  [제목 16sp semibold / 날짜 14sp muted] | AQ 점수 17sp bold accent | chevron 20dp.
  ID 보존: tvRecentTopic/tvRecentDate/tvRecentAq (LearnFragment findViewById 규약).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRecentRow"
    style="@style/Widget.SeSAC.Card.D8C"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRecentTopic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.RowTitle"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvRecentDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.RowDate"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecentAq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textAppearance="@style/TextAppearance.SeSAC.D8C.RowScore" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="상세 보기"
            android:src="@drawable/ic_chevron_right_24"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>