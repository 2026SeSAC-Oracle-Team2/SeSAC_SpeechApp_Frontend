<?xml version="1.0" encoding="utf-8"?>
<!--
  D-8-C1: LISTEN 선택지 행 (시안 learn.$themeId listen 선택지 재작성).
  텍스트 모드: 세로 행 64dp radius 22dp 테두리 2dp / 이미지 모드: (부모가 2열 그리드로
  배치 — 코드에서 containerChoices orientation 전환). 선택/정답/오답 배경은 코드에서
  bg_choice_selected/correct/wrong으로 전환.
  ID 보존: tvChoiceText/ivChoiceImage (ProblemActivity findViewById).
  ⚠ 시안 정오답 색 표시는 제출 후 — 기존 클라는 즉시제출이라 정오답 피드백 화면 자체가
    없음 → 색 강조는 기존 로직(선택 강조만) 유지, 정오답 표시는 보류 항목 (기획 확인 필요).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_question_card"
    android:minHeight="64dp"
    android:padding="8dp">

    <!-- 텍스트형 (mediaType=text) -->
    <TextView
        android:id="@+id/tvChoiceText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <!-- 이미지형 (mediaType=image) — 기본 숨김 (h-32=128dp radius 18dp) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivChoiceImage"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:contentDescription="선택지 이미지"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.SeSAC.RoundedImage" />
</FrameLayout>