<?xml version="1.0" encoding="utf-8"?>
<!-- LISTEN 선택지 카드 — 텍스트형/이미지형 공용 컨테이너. 탭하면 즉시 제출. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_question_card"
    android:minHeight="64dp"
    android:padding="8dp">

    <!-- 텍스트형 (mediaType=text) -->
    <TextView
        android:id="@+id/tvChoiceText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <!-- 이미지형 (mediaType=image) — 기본 숨김 -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivChoiceImage"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:contentDescription="선택지 이미지"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.SeSAC.CircleImage" />
</FrameLayout>