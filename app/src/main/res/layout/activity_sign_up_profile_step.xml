<?xml version="1.0" encoding="utf-8"?>
<!--
  D-8-C1: 회원가입 2단계 (시안 signup.tsx 성별·생년·취미·태그 부분 재작성 — 기존 2단계 플로우 유지).
  성별 3버튼 가로(여성/남성/선택 안 함 라디오형) → 생년월일(터치=DatePicker) → 취미 →
  관심사 태그 카드(칩 wrap) → 다음으로 전폭 버튼.
  ID 보존: chipGroupSex/chipSexM/chipSexF/tilBirthDate/etBirthDate/tilHobby/etHobby/
           chipGroupTags/btnNext/btnBack/toolbar (SignUpProfileStepActivity 바인딩).
  시안 성별 3번째 "선택 안 함" 칩 신설 — kt 로직 "둘 중 1개만" 유지 + 새 칩은 미연결
  (보고서 보류 항목: 선택 안 함 동작은 기획 확인 필요 — 지시문 §4-2 kt 수정 최소 원칙).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grad_warm">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로"
            android:src="@drawable/ic_close_24"
            app:tint="@color/text_secondary" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- PageTitle (1단계 문구 유지) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/signup_page_title_d8c"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.PageTitle" />

            <!-- (4) 성별: 라벨 + 3버튼 가로 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/signup_label_gender"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.SettingRow"
                android:textSize="15sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="12dp"
                app:selectionRequired="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSexF"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:minHeight="52dp"
                    android:text="@string/signup_profile_sex_female"
                    android:textAppearance="@style/TextAppearance.SeSAC.Body"
                    android:textSize="15sp"
                    app:chipBackgroundColor="@color/brand_secondary"
                    app:chipCornerRadius="@dimen/radius_xl"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSexM"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:minHeight="52dp"
                    android:text="@string/signup_profile_sex_male"
                    android:textAppearance="@style/TextAppearance.SeSAC.Body"
                    android:textSize="15sp"
                    app:chipBackgroundColor="@color/brand_secondary"
                    app:chipCornerRadius="@dimen/radius_xl"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSexNone"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:minHeight="52dp"
                    android:text="@string/signup_gender_none"
                    android:textAppearance="@style/TextAppearance.SeSAC.Body"
                    android:textSize="15sp"
                    app:chipBackgroundColor="@color/brand_secondary"
                    app:chipCornerRadius="@dimen/radius_xl"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="2dp" />
            </com.google.android.material.chip.ChipGroup>

            <!-- 생년월일 (필수 — DatePicker) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/signup_label_birth"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.SettingRow"
                android:textSize="15sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBirthDate"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="@dimen/radius_xl"
                app:boxCornerRadiusBottomStart="@dimen/radius_xl"
                app:boxCornerRadiusTopEnd="@dimen/radius_xl"
                app:boxCornerRadiusTopStart="@dimen/radius_xl"
                app:boxStrokeColor="@color/border"
                app:boxStrokeWidth="2dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBirthDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:hint="@string/signup_profile_birth_hint"
                    android:inputType="none"
                    android:longClickable="false"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SeSAC.Body"
                    android:textSize="17sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 취미 (선택) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/signup_label_hobby"
                android:textAppearance="@style/TextAppearance.SeSAC.D8C.SettingRow"
                android:textSize="15sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHobby"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="@dimen/radius_xl"
                app:boxCornerRadiusBottomStart="@dimen/radius_xl"
                app:boxCornerRadiusTopEnd="@dimen/radius_xl"
                app:boxCornerRadiusTopStart="@dimen/radius_xl"
                app:boxStrokeColor="@color/border"
                app:boxStrokeWidth="2dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHobby"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="@string/signup_hobby_placeholder"
                    android:inputType="text"
                    android:maxLength="100"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SeSAC.Body"
                    android:textSize="17sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- (5) 관심사 태그 카드 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SeSAC.Card.D8C"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/signup_tag_title"
                        android:textAppearance="@style/TextAppearance.SeSAC.D8C.SettingRow"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvTagCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/signup_profile_tag_hint"
                        android:textAppearance="@style/TextAppearance.SeSAC.D8C.RowDate"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupTags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- (6) 다음으로 전폭 버튼 (고정 하단) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="@dimen/btn_height"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_grad_brand_r22"
        android:backgroundTint="@null"
        android:text="@string/signup_btn_next_d8c"
        android:textAppearance="@style/TextAppearance.SeSAC.H4"
        android:textColor="@color/brand_on_primary"
        android:textStyle="bold"
        app:cornerRadius="@dimen/radius_xl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>