<?xml version="1.0" encoding="utf-8"?>
<!-- P3-26 로딩 화면: 마스코트 + 스피너 + 재시도 + D-7 [시작] 게이트 (로딩 완료 후 권한 선제 확인) -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- D-8③ 시안 Loading 컴포넌트: duck 마스코트 96dp (애니메이션 없음 — 시니어 가독성) -->
    <ImageView
        android:id="@+id/imgMascotDuck"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="덕분이"
        android:src="@drawable/img_duck"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.40" />

    <!-- 기존 텍스트 마스코트 — D-8③에서 이미지로 대체 (ID 보존, gone) -->
    <TextView
        android:id="@+id/tvMascot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/splash_title"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/loading_session"
        android:textAppearance="@style/TextAppearance.SeSAC.H4"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMascot" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:indeterminate="true"
        app:indicatorColor="@color/primary"
        app:indicatorSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMessage" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/loading_session_fail"
        android:textColor="@color/error"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinner" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/primary"
        android:text="@string/btn_retry"
        android:textColor="@color/surface"
        android:visibility="gone"
        app:cornerRadius="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvError" />

    <!-- D-7 1.3: 로딩 완료 후 [시작] — 마이크 권한 선제 확인 게이트 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStart"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:minWidth="200dp"
        android:backgroundTint="@color/primary"
        android:text="@string/btn_start"
        android:textAppearance="@style/TextAppearance.SeSAC.H4"
        android:textColor="@color/surface"
        android:visibility="gone"
        app:cornerRadius="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnRetry" />

</androidx.constraintlayout.widget.ConstraintLayout>