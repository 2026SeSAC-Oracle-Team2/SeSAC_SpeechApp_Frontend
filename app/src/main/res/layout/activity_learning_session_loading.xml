<?xml version="1.0" encoding="utf-8"?>
<!--
  D-8-C1: 세션 로딩 화면 (시안 learn.$themeId intro 재작성).
  intro = Loading(오리 bounce+메시지) → 1.2초 후 "로딩 완료!" + 오리 120dp +
  "{세션명} 준비가 끝났어요." + [시작] 버튼.
  시간값 1.2초는 로딩 API 응답 대기가 우선(기획 06 v1.7) — API 응답 후 즉시 완료 전환
  (기획 우선 적용 — 시안의 고정 1.2초 타이머는 폐기, 보고서 표기).
  ID 보존: imgMascotDuck/tvMascot(GONE)/tvMessage/spinner/tvError/btnRetry/btnStart.
  신규: tvReadyTitle(로딩 완료! 제목)·tvReadySession(세션명 문구).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grad_warm">

    <!-- 오리 96dp(로딩) / 120dp(완료 — 코드에서 크기 전환) -->
    <ImageView
        android:id="@+id/imgMascotDuck"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="덕분이"
        android:src="@drawable/img_duck"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.32" />

    <!-- 기존 텍스트 마스코트 — ID 보존, gone -->
    <TextView
        android:id="@+id/tvMascot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/splash_title"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 로딩 상태 메시지 (로딩 중/실패) -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/loading_session"
        android:textAppearance="@style/TextAppearance.SeSAC.Body"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMascot" />

    <!-- 완료 상태: "로딩 완료!" 22sp bold + "{세션명} 준비가 끝났어요." -->
    <TextView
        android:id="@+id/tvReadyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/loading_ready_title"
        android:textAppearance="@style/TextAppearance.SeSAC.D8C.ReadyTitle"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgMascotDuck" />

    <TextView
        android:id="@+id/tvReadySession"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.SeSAC.D8C.PageDesc"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvReadyTitle" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:indeterminate="true"
        app:indicatorColor="@color/primary"
        app:indicatorSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMessage" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/loading_session_fail"
        android:textColor="@color/error"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinner" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        style="@style/Widget.SeSAC.Button.D8C.Outline"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:text="@string/btn_retry"
        android:visibility="gone"
        app:cornerRadius="@dimen/radius_xl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvError" />

    <!-- D-7 1.3: 로딩 완료 후 [시작] — 마이크 권한 선제 확인 게이트 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStart"
        style="@style/Widget.SeSAC.Button.D8C.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_height"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="32dp"
        android:text="@string/btn_start_session"
        android:visibility="gone"
        app:cornerRadius="@dimen/radius_xl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvReadySession" />

</androidx.constraintlayout.widget.ConstraintLayout>