<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Theme: SeSAC Speech Practice -->
    <style name="Theme.SeSAC_Speech" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_secondary</item>
        <item name="colorOnPrimaryContainer">@color/brand_secondary_fg</item>

        <!-- Secondary (same as Primary for unified look) -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_secondary_fg</item>
        <item name="colorSecondaryContainer">@color/brand_secondary</item>
        <item name="colorOnSecondaryContainer">@color/brand_secondary_fg</item>

        <!-- Surface / Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/background</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@android:color/white</item>
        <item name="colorErrorContainer">@color/error_border</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>

    <!-- Splash Theme (before login) -->
    <style name="Theme.SeSAC_Speech.Splash" parent="Theme.SeSAC_Speech">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/brand_grad_warm_end</item>
    </style>
</resources>
