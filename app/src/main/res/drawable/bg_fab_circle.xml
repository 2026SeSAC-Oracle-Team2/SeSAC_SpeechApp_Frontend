<?xml version="1.0" encoding="utf-8"?>
<!-- D-8-C1: FAB 오리 원형 버튼 (gradient-fab: brand-yellow-light→dark + brand-yellow-light 4dp 보더) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="270"
        android:startColor="@color/brand_yellow_light"
        android:endColor="@color/brand_yellow_dark"
        android:type="linear" />
    <stroke
        android:width="4dp"
        android:color="@color/brand_yellow_light" />
</shape>
