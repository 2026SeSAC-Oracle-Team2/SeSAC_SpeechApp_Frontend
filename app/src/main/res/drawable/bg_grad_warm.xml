<?xml version="1.0" encoding="utf-8"?>
<!-- D-8③ 시안 gradient-warm(160deg) — Screen 공통 배경 (surface-warm) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- CSS 160deg(거의 상→하, 살짝 우측) ≈ Android angle 280 -->
    <gradient
        android:angle="280"
        android:startColor="@color/brand_grad_warm_start"
        android:endColor="@color/brand_grad_warm_end"
        android:type="linear" />
</shape>